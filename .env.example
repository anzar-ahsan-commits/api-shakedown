# Copy to .env and fill in. Everything is optional: the default is local Ollama with qwen3:8b.

# SHAKEDOWN_PROVIDER=ollama          # ollama | openai | anthropic
# SHAKEDOWN_MODEL=qwen3:8b           # defaults per provider if unset
# SHAKEDOWN_OLLAMA_URL=http://localhost:11434   # where Ollama runs (Ollama only)
# SHAKEDOWN_BASE_URL=                # override for the selected provider, e.g. OpenAI-compatible
# SHAKEDOWN_TEMPERATURE=             # unset = provider default
# SHAKEDOWN_TIMEOUT=                 # seconds; unset = 600 for Ollama, 120 for cloud
# SHAKEDOWN_CONTEXT_WINDOW=16384     # Ollama only; raise for big specs if you have the memory
# SHAKEDOWN_REASONING=               # Ollama only: true/false forces thinking on/off
# Per-agent thinking; the default turns it off for the generator agents (much faster):
# SHAKEDOWN_AGENT_REASONING={"testdata": false, "stubs": false, "contracts": false, "chaos": false}
# Per-agent model overrides (a provider prefix switches provider for that agent):
# SHAKEDOWN_AGENT_MODELS={"reviewer": "anthropic:claude-sonnet-5-5", "stubs": "qwen3:14b"}

# Bring your own key (standard vendor variable names):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
